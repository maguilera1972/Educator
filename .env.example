# Copiez ce fichier vers .env et adaptez les valeurs :
#   cp .env.example .env

# Environnement
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://votre-domaine.example
TRUST_PROXY=1

# Obligatoire en production (secret long et aléatoire)
JWT_SECRET=remplacer-par-un-secret-fort

# Sole LMS administrator (created / enforced on startup)
ADMIN_EMAIL=michel.aguilera@also.com
ADMIN_NAME=Michel Aguilera
ADMIN_PASSWORD=ChangeMeNow!

# ALSO Portal identity lookup (LMS signup) + shared avatars
PORTAL_LOOKUP_URL=http://172.16.11.8
PORTAL_PUBLIC_URL=https://also.eureka-training.online
PORTAL_LMS_LOOKUP_SECRET=
# Optional: dedicated HMAC for portal avatar URLs (defaults to PORTAL_LMS_LOOKUP_SECRET)
# PORTAL_AVATAR_TOKEN_SECRET=
# Optional override for shared avatar directory (default /mnt/also-shared/avatars)
# PORTAL_AVATARS_DIR=/mnt/also-shared/avatars

# E-mail (optionnel — Graph / Microsoft 365)
# MAIL_FROM=info@example.com
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
