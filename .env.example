# Copiez ce fichier vers .env et adaptez les valeurs :
#   cp .env.example .env

# Environnement
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://votre-domaine.example
TRUST_PROXY=1

# Obligatoire en production (secret long et aléatoire)
JWT_SECRET=remplacer-par-un-secret-fort

# Administrateur initial (créé au premier démarrage)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=ChangeMeNow!

# E-mail (optionnel — Graph / Microsoft 365)
# MAIL_FROM=info@example.com
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
